# =====================================================================
#  PLATAFORMA DE SUBASTAS DE VEHICULOS - VARIABLES DE ENTORNO
#  Copiar este archivo como ".env" y completar los valores reales.
#  El archivo .env esta en .gitignore y NUNCA debe subirse al repositorio.
# =====================================================================

# --- Firebase Realtime Database (proyecto: subastas-vehiculos-marielos) ---
# Project ID  -> Configuracion del proyecto > General
FIREBASE_PROJECT_ID=

# Client email de la cuenta de servicio
# -> Configuracion del proyecto > Cuentas de servicio > (la cuenta) > Claves privadas
FIREBASE_CLIENT_EMAIL=

# Llave privada (Service account). En Render se pega con los saltos de linea
# escapados; el codigo hace process.env.FIREBASE_PRIVATE_KEY.replace(/\\n/g, '\n')
FIREBASE_PRIVATE_KEY=

# URL de Realtime Database (sin barra final)
FIREBASE_DATABASE_URL=https://subastas-vehiculos-marielos-default-rtdb.firebaseio.com

# --- Firmado de tokens JWT (obligatorio, cadena larga y aleatoria) ---
JWT_SECRET=
JWT_EXPIRES_IN=8h

# --- Aplicacion ---
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
