{
  "name": "plataforma-subastas-vehiculos",
  "version": "1.0.0",
  "private": true,
  "description": "Plataforma de subastas de vehiculos en tiempo real estilo Copart (Next.js + Firebase Realtime Database + Socket.IO, arquitectura hexagonal)",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:socket": "node server.js",
    "build": "next build",
    "start": "node server.js",
    "db:init": "node scripts/init-db.js",
    "db:seed": "node scripts/seed.js"
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "firebase-admin": "^14.5.0",
    "jsonwebtoken": "9.0.2",
    "next": "15.5.26",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "socket.io": "4.8.1",
    "socket.io-client": "4.8.1"
  }
}
